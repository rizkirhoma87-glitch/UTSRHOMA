<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_primary"
        android:theme="@style/Theme.Uts">

        <!-- Status Bar Scrim: #1B2D4A -->
        <View
            android:id="@+id/status_bar_scrim_detail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/navy_dark" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/navy_primary"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/title_detail"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/iv_detail_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@color/surface_gray"
                android:scaleType="centerCrop"
                android:contentDescription="@string/label_title"
                tools:srcCompat="@drawable/ic_image_placeholder" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_detail_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:textColor="@color/category_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="beauty" />

                    <TextView
                        android:id="@+id/tv_detail_availability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge"
                        android:textColor="@color/badge_stock_in_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="In Stock" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_rate" />

                        <TextView
                            android:id="@+id/tv_detail_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/rating_gold"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="4.5 / 5.0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Essence Mascara Lash Princess" />

                <!-- Price & Discount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_detail_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/price_color"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="$9.99" />

                    <TextView
                        android:id="@+id/tv_detail_discount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_badge"
                        android:textColor="@color/badge_stock_low_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="10.48% OFF" />
                </LinearLayout>

                <!-- Tags -->
                <TextView
                    android:id="@+id/tv_detail_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Tags: beauty, mascara" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#15000000" />

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_description"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    tools:text="The Essence Mascara Lash Princess is a popular mascara known for its volumizing and lengthening effects." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#15000000" />

                <!-- Product Specifications Card -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spesifikasi Produk"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_gray"
                    app:strokeColor="#15000000"
                    app:strokeWidth="1dp">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:stretchColumns="1">

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_product_id"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_id"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="1" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_brand"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_brand"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="Essence" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_sku"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_sku"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="BEA-ESS-ESS-001" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_stock"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_stock"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="99 unit" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_weight"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_weight"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="4 g" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_dimensions"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_dimensions"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="15.1 × 13.1 × 23.0 cm" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_warranty"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_warranty"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="1 week warranty" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_shipping"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_shipping"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="Ships in 3-5 business days" />
                        </TableRow>

                        <TableRow android:paddingBottom="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_return_policy"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_return"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="No return policy" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="140dp"
                                android:text="@string/label_min_order"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                            <TextView
                                android:id="@+id/tv_spec_min_order"
                                android:textColor="@color/black"
                                android:textSize="13sp"
                                tools:text="48 pcs" />
                        </TableRow>
                    </TableLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#15000000" />

                <!-- Reviews Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_reviews"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_no_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/no_reviews"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_review" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Detail ProgressBar -->
    <ProgressBar
        android:id="@+id/progress_bar_detail"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
